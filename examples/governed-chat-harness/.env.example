# DashClaw Connection
DASHCLAW_BASE_URL=https://my-dashclaw.vercel.app
DASHCLAW_API_KEY=your_dashclaw_api_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional
# Identity shown in the Fleet and Decisions Ledger
DASHCLAW_AGENT_ID=claude-chat-harness
# Model the harness drives
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# What to do when the guard cannot be reached: block | warn | allow
DASHCLAW_GUARD_UNAVAILABLE_POLICY=warn
